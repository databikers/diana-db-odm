{
  "name": "@diana-db/odm",
  "version": "4.6.6",
  "description": "ODM for DianaDB",
  "author": "Data Bikers Limited",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "build": "rm -rf dist && tsc && node_modules/.bin/tsc-alias && eslint src/**/*.ts{,x}",
    "eslint": "eslint src --ext .ts",
    "prettier-check": "prettier . --check",
    "format": "prettier .  --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.6",
    "@types/prettier": "3.0.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0",
    "husky": "^9.1.7",
    "prettier-plugin-multiline-arrays": "4.1.11",
    "tsc-alias": "^1.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/databikers/diana-db-odm.git"
  },
  "bugs": {
    "url": "https://github.com/databikers/diana-db-odm/issues"
  },
  "homepage": "https://github.com/databikers/diana-db-odm#readme",
  "publishConfig": {
    "access": "public"
  }
}
